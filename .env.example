# Copy this file to .env and fill in real values.
# Never commit real keys to the repository.

# Speech-to-text provider:
#   azure (default) — Azure Speech service (true streaming with interim results)
#   mock            — no API key needed; emits fake Urdu partial/final text
STT_PROVIDER=azure

# Azure Speech service credentials. Used when STT_PROVIDER=azure.
# Region examples: eastus, westeurope
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Translation provider (Milestone 4+).
# OPENAI_API_KEY=
