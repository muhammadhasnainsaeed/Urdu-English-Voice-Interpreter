# Copy this file to .env and fill in real values.
# Never commit real keys to the repository.

# Speech-to-text provider:
#   azure (default) — Azure Speech service (true streaming with interim results)
#   whisper         — local whisper.cpp engine (offline; requires npm run setup:whisper)
#   mock            — no API key needed; emits fake Urdu partial/final text
STT_PROVIDER=azure

# Azure Speech service credentials. Used when STT_PROVIDER=azure.
# Region examples: eastus, westeurope
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Local Whisper provider. Used when STT_PROVIDER=whisper.
# Run `npm run setup:whisper` once to build the engine and download the model.
# Defaults match the paths written by setup:whisper under ~/.cache/urdu-english-interpreter/.
# Whisper (local offline STT). Defaults live under
# ~/.cache/urdu-english-interpreter/. Run `npm run setup:whisper` first.
# WHISPER_EXECUTABLE_PATH=
# WHISPER_MODEL_PATH=
# WHISPER_LANGUAGE=ur
# WHISPER_THREADS=4

# Translation provider (Milestone 4+).
# OPENAI_API_KEY=
