# Copy this file to .env and fill in real values.
# Never commit real keys to the repository.

# Speech-to-text provider:
#   azure (default) — Azure Speech service (true streaming with interim results)
#   whisper         — local whisper.cpp engine (offline; requires npm run setup:whisper)
#   mock            — no API key needed; emits fake Urdu partial/final text
STT_PROVIDER=azure

# Azure Speech service credentials. Used when STT_PROVIDER=azure.
# Region examples: eastus, westeurope
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Local Whisper provider. Used when STT_PROVIDER=whisper.
# Run `npm run setup:whisper` once to build the engine and download the model.
# Defaults match the paths written by setup:whisper under ~/.cache/urdu-english-interpreter/.
# Whisper (local offline STT). Defaults live under
# ~/.cache/urdu-english-interpreter/. Run `npm run setup:whisper` first.
# WHISPER_EXECUTABLE_PATH=
# WHISPER_MODEL_PATH=
# WHISPER_LANGUAGE=ur
# WHISPER_THREADS=4

# Translation provider (Milestone 4+).
#   azure    (default) — Azure Translator cloud service; requires AZURE_TRANSLATOR_KEY and AZURE_TRANSLATOR_REGION
#   mymemory          — free tier, no signup, no key required (1000 words/day anonymous)
#   mock              — no API key; returns deterministic Urdu→English translations
TRANSLATION_PROVIDER=azure

# Azure Translator credentials. Required when TRANSLATION_PROVIDER=azure.
# Create a Translator resource at https://portal.azure.com → Cognitive Services → Translator.
# F0 tier: 2M characters/month free, no credit card required.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
