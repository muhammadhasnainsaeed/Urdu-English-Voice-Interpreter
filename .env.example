# Copy this file to .env and fill in real values.
# Never commit real keys to the repository.

# Speech-to-text provider:
#   azure (default) — Azure Speech service (true streaming with interim results)
#   whisper         — local whisper.cpp engine (offline; requires npm run setup:whisper)
#   mock            — no API key needed; emits fake Urdu partial/final text
STT_PROVIDER=azure

# Azure Speech service credentials. Used when STT_PROVIDER=azure.
# Region examples: eastus, westeurope
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Local Whisper provider. Used when STT_PROVIDER=whisper.
# Run `npm run setup:whisper` once to build the engine and download the model.
# Defaults match the paths written by setup:whisper under ~/.cache/urdu-english-interpreter/.
# Whisper (local offline STT). Defaults live under
# ~/.cache/urdu-english-interpreter/. Run `npm run setup:whisper` first.
# WHISPER_EXECUTABLE_PATH=
# WHISPER_MODEL_PATH=
# WHISPER_LANGUAGE=ur
# WHISPER_THREADS=4

# Translation provider (Milestone 4+).
#   azure    (default) — Azure Translator cloud service; requires AZURE_TRANSLATOR_KEY and AZURE_TRANSLATOR_REGION
#   mymemory          — free tier, no signup, no key required (1000 words/day anonymous)
#   mock              — no API key; returns deterministic Urdu→English translations
#
# NOTE: MyMemory is suitable primarily for development / free-tier testing.
# It rate-limits aggressively (HTTP 429) and its anonymous limits persist
# per-IP across app restarts. For production / sustained real-time
# translation traffic, use a provider appropriate for that load (e.g. azure).
TRANSLATION_PROVIDER=azure

# MyMemory rate-limit cooldown (milliseconds). Used when MyMemory returns
# HTTP 429 without a usable Retry-After header. While cooling down, no
# requests are sent; there are no automatic retries, and suppressed
# transcripts are dropped (never replayed after cooldown).
# MYMEMORY_429_COOLDOWN_MS=60000

# Azure Translator credentials. Required when TRANSLATION_PROVIDER=azure.
# Create a Translator resource at https://portal.azure.com → Cognitive Services → Translator.
# F0 tier: 2M characters/month free, no credit card required.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Text-to-speech provider (Milestone 5+).
#   azure (default) — Azure Speech TTS (same credentials as STT); requires AZURE_SPEECH_KEY and AZURE_SPEECH_REGION
#   say             — macOS built-in TTS via `say` command (offline, no API key, zero setup)
#   mock            — no API key; simulates TTS with a short delay (for automated testing)
TTS_PROVIDER=azure

# Azure TTS voice. Used when TTS_PROVIDER=azure.
# Full list: https://learn.microsoft.com/azure/ai-services/speech-service/language-support?tabs=tts#neural-voices
# AZURE_TTS_VOICE=en-US-JennyNeural

# STT-final duplicate-suppression window (milliseconds).
# Identical consecutive final transcripts arriving within this window are
# suppressed BEFORE any translation provider request (prevents wasted API
# calls when a recognizer re-finalizes the same sentence). The window slides
# forward on each suppressed duplicate. Set to 0 to disable dedup.
# Invalid values fall back to the default with a [CONFIG] warning.
# STT_FINAL_DEDUPE_WINDOW_MS=2000

# TTS duplicate-suppression window (milliseconds).
# Identical translations arriving within this window after the same text was
# spoken are suppressed. Set to 0 to disable dedup (every translation spoken).
# Must be a non-negative integer; invalid values warn and use the default.
# TTS_DEDUPE_WINDOW_MS=2000

# Pipeline latency telemetry (development-only).
# When set to 1:
#   - main-process debug logs include [TELEMETRY] trace lines
#   - the renderer shows the "Pipeline Performance" panel
#     (per-phase latencies + rolling last-20 end-to-end stats)
PIPELINE_DEBUG=0
