{
  "name": "urdu-english-interpreter",
  "version": "1.0.0",
  "description": "Real-time Urdu-to-English voice interpreter for macOS meetings",
  "main": "dist/main/index.js",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "dev": "node scripts/dev.js",
    "start": "npm run build && electron .",
    "setup:whisper": "bash scripts/setup-whisper.sh",
    "type-check": "tsc --noEmit",
    "test": "npx tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.js\" \"tests/**/*.ts\" \"packages/**/*.ts\" *.config.js *.config.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/**/*.js\" \"tests/**/*.ts\" \"packages/**/*.ts\" *.config.js *.config.mjs",
    "package": "npm run build && electron-builder --mac --arm64",
    "package:dir": "npm run build && electron-builder --mac --arm64 --dir"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.38.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "build": {
    "appId": "com.urduenglish.voiceinterpreter",
    "productName": "Urdu English Interpreter",
    "directories": {
      "output": "dist_electron",
      "buildResources": "packaging"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "identity": null,
      "gatekeeperAssess": false,
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "This app uses the microphone to capture your Urdu speech and provide real-time English subtitles and audio during meetings.",
        "NSHumanReadableCopyright": "© 2026 Urdu English Interpreter"
      }
    },
    "dmg": {
      "sign": false
    }
  }
}
